# -------------------------------------------------------
# PostgreSQL
# -------------------------------------------------------
# Nome do banco da aplicação.
POSTGRES_DB=fiscalanalyzer
# Usuário de conexão do banco.
POSTGRES_USER=fiscalanalyzer
# Senha do usuário de conexão do banco.
POSTGRES_PASSWORD=change_me

# -------------------------------------------------------
# RabbitMQ
# -------------------------------------------------------
# Usuário do broker RabbitMQ.
RABBITMQ_USER=fiscalanalyzer
# Senha do broker RabbitMQ.
RABBITMQ_PASSWORD=change_me

# -------------------------------------------------------
# Redis (rate-limit/lockout distribuído)
# -------------------------------------------------------
# Host do Redis.
REDIS_HOST=localhost
# Porta do Redis.
REDIS_PORT=6379
# Senha do Redis (vazio se sem auth).
REDIS_PASSWORD=

# -------------------------------------------------------
# Segurança de usuário (JWT + bootstrap)
# -------------------------------------------------------
# Token one-shot para inicializar o primeiro admin em ambiente novo.
APP_SECURITY_BOOTSTRAP_TOKEN=5be700a619329357ebb05c3a54e410d647d6a7017207ebc5d8449d6c362ca15e
# Segredo HMAC para assinatura/validação de JWT (mínimo recomendado: 32 chars).
APP_SECURITY_JWT_SECRET=603539827b850a27be5c140572a3fa664f2ca0e03549f97e68dc93cc636f282d
# TTL do access token JWT em segundos.
APP_SECURITY_JWT_ACCESS_TOKEN_TTL_SECONDS=3600

# -------------------------------------------------------
# Auditoria de segurança (agent auth/upload)
# -------------------------------------------------------
# Nível de auditoria de autenticação: off | failures | all.
APP_SECURITY_AUTH_AUDIT_MODE=failures
# Liga/desliga o job de retenção de auditoria.
APP_SECURITY_AUDIT_CLEANUP_ENABLED=true
# Cron do cleanup de auditoria (timezone da JVM).
APP_SECURITY_AUDIT_CLEANUP_CRON=0 30 3 * * *
# Retenção (dias) da tabela agent_auth_audit.
APP_SECURITY_AUDIT_CLEANUP_AUTH_RETENTION_DAYS=90
# Retenção (dias) da tabela agent_upload_audit.
APP_SECURITY_AUDIT_CLEANUP_UPLOAD_RETENTION_DAYS=30
# Quantidade de linhas removidas por batch de cleanup.
APP_SECURITY_AUDIT_CLEANUP_BATCH_SIZE=5000
# Quantidade máxima de batches por execução.
APP_SECURITY_AUDIT_CLEANUP_MAX_BATCHES=100

# -------------------------------------------------------
# Rate-limit/lockout do agent
# -------------------------------------------------------
# Liga/desliga rate-limit.
APP_SECURITY_RATE_LIMIT_ENABLED=true
# Backend do rate-limit: redis | in-memory.
APP_SECURITY_RATE_LIMIT_BACKEND=redis
# Prefixo de chaves no Redis para controles de rate-limit/lockout.
APP_SECURITY_RATE_LIMIT_REDIS_KEY_PREFIX=fiscalanalyzer:security:
# TTL (segundos) dos buckets de token no Redis.
APP_SECURITY_RATE_LIMIT_REDIS_TOKEN_BUCKET_TTL_SECONDS=600
# Limite de requests por segundo em /agent/session.
APP_SECURITY_RATE_LIMIT_AGENT_SESSION_RPS=1
# Burst máximo em /agent/session.
APP_SECURITY_RATE_LIMIT_AGENT_SESSION_BURST=5
# Limite de requests por segundo em /agent/upload-url.
APP_SECURITY_RATE_LIMIT_AGENT_UPLOAD_URL_RPS=20
# Burst máximo em /agent/upload-url.
APP_SECURITY_RATE_LIMIT_AGENT_UPLOAD_URL_BURST=200
# Limite de requests por segundo em /imports/manifest.
APP_SECURITY_RATE_LIMIT_AGENT_MANIFEST_RPS=5
# Burst máximo em /imports/manifest.
APP_SECURITY_RATE_LIMIT_AGENT_MANIFEST_BURST=20
# Limite de requests por segundo para tráfego anônimo (sem chave válida).
APP_SECURITY_RATE_LIMIT_ANONYMOUS_RPS=2
# Burst máximo para tráfego anônimo.
APP_SECURITY_RATE_LIMIT_ANONYMOUS_BURST=10
# Número de falhas de auth para iniciar lockout.
APP_SECURITY_RATE_LIMIT_AUTH_FAILURE_THRESHOLD=20
# Janela de contagem de falhas de auth (segundos).
APP_SECURITY_RATE_LIMIT_AUTH_FAILURE_WINDOW_SECONDS=300
# Duração do lockout por excesso de falhas (segundos).
APP_SECURITY_RATE_LIMIT_AUTH_FAILURE_LOCKOUT_SECONDS=600

# -------------------------------------------------------
# Storage S3 compatível (Backblaze B2)
# -------------------------------------------------------
# Endpoint S3 da conta.
STORAGE_S3_ENDPOINT=https://s3.<region>.backblazeb2.com
# Access Key da aplicação.
STORAGE_S3_ACCESS_KEY=<key_id>
# Secret Key da aplicação.
STORAGE_S3_SECRET_KEY=<application_key>
# Bucket usado para XML/ZIP.
STORAGE_S3_BUCKET=<bucket_name>
# Região S3 lógica.
STORAGE_S3_REGION=us-east-1
# true para path-style; false para virtual-hosted-style.
STORAGE_S3_PATH_STYLE_ACCESS=false
